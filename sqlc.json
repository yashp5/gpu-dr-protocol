{
  "servers": [
    {
      "engine": "postgresql",
      "uri": "postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable"
    }
  ],
  "sql": [
    {
      "engine": "postgresql",
      "gen": {
        "go": {
          "emit_json_tags": true,
          "emit_enum_valid_method": true,
          "emit_all_enum_values": true,
          "emit_sql_as_comment": true,
          "json_tags_case_style": "snake",
          "out": "generated/sqlc",
          "overrides": [
          ],
          "package": "sqlc",
          "sql_package": "pgx/v5"
        }
      },
      "queries": [
        "./query.sql"
      ],
      "schema": "./schema.sql",
      "strict_order_by": true
    }
  ],
  "version": "2"
}